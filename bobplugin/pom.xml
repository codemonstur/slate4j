<project>
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.codemonstur</groupId>
        <artifactId>slate4j</artifactId>
        <version>4</version>
    </parent>

    <artifactId>slate4j-bobplugin</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>The bob plugin for slate4j.</description>

    <dependencies>
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>slate4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>bobthebuildtool</artifactId>
            <version>12</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>jcli</artifactId>
            <version>2.0.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Bob-Plugin-Class>slate4j.BobPlugin</Bob-Plugin-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
